CREATE TABLE article (
    id TEXT NOT NULL PRIMARY KEY,
    feed_source_id TEXT NOT NULL,
    title TEXT NOT NULL,
    summary TEXT,
    body_markdown TEXT,
    author TEXT,
    published_at INTEGER NOT NULL,
    fetched_at INTEGER NOT NULL,
    image_url TEXT,
    original_url TEXT NOT NULL,
    read INTEGER NOT NULL DEFAULT 0,
    bookmarked INTEGER NOT NULL DEFAULT 0,
    ai_summary TEXT,
    ai_bias_score REAL,
    ai_topics TEXT NOT NULL DEFAULT '[]',
    relevance_score REAL,
    FOREIGN KEY (feed_source_id) REFERENCES feed_source(id)
);

CREATE INDEX idx_article_feed_source ON article(feed_source_id);
CREATE INDEX idx_article_published ON article(published_at);
CREATE INDEX idx_article_read ON article(read);

selectAllArticles:
SELECT * FROM article
ORDER BY published_at DESC;

selectArticlesByFeed:
SELECT * FROM article
WHERE feed_source_id IN (:feedIds)
ORDER BY published_at DESC;

selectUnreadArticles:
SELECT * FROM article
WHERE read = 0
ORDER BY published_at DESC;

selectBookmarkedArticles:
SELECT * FROM article
WHERE bookmarked = 1
ORDER BY published_at DESC;

selectArticleById:
SELECT * FROM article
WHERE id = :id;

selectArticlesByRelevance:
SELECT * FROM article
WHERE relevance_score IS NOT NULL
ORDER BY relevance_score DESC;

selectArticlesByTitle:
SELECT * FROM article
ORDER BY title ASC;

searchArticles:
SELECT * FROM article
WHERE title LIKE '%' || :query || '%'
   OR summary LIKE '%' || :query || '%'
ORDER BY published_at DESC;

insertArticle:
INSERT OR REPLACE INTO article (
    id, feed_source_id, title, summary, body_markdown, author,
    published_at, fetched_at, image_url, original_url, read, bookmarked,
    ai_summary, ai_bias_score, ai_topics, relevance_score
) VALUES (
    :id, :feedSourceId, :title, :summary, :bodyMarkdown, :author,
    :publishedAt, :fetchedAt, :imageUrl, :originalUrl, :read, :bookmarked,
    :aiSummary, :aiBiasScore, :aiTopics, :relevanceScore
);

updateArticleRead:
UPDATE article SET read = :isRead WHERE id = :id;

updateArticleBookmarked:
UPDATE article SET bookmarked = :isBookmarked WHERE id = :id;

deleteOldArticles:
DELETE FROM article WHERE fetched_at < :beforeDate;

countArticles:
SELECT COUNT(*) FROM article;
